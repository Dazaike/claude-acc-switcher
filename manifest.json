{
  "manifest_version": 3,
  "name": "Claude Account Switcher",
  "key": "",
  "version": "19.7",
  "description": "Save and switch Claude web account snapshots using cookies plus origin storage.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude Account Switcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "claude-bridge.js"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "o200k_base.js",
        "content.js",
        "enhance.js"
      ],
      "run_at": "document_start"
    }
  ]
}
